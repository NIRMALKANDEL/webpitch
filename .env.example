# Copy to .env.local for local development, and add both in Vercel → Project → Settings → Environment Variables.

# Web3Forms access key. Get it free at https://web3forms.com (enter nirmalatlance@gmail.com; the key arrives by email).
# Enquiries are delivered to the email the key was created with. Without it, the form offers WhatsApp instead.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Your live site URL, used for canonical URLs, the sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
